#!/bin/bash
#SBATCH --job-name=llm-mas-ethics
#SBATCH --partition=ampere
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --time=01:00:00
#SBATCH --output=pilot-two-llms-%j.out

echo "===== JOB INFO ====="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $(hostname)"
echo "Start time: $(date)"
echo

module load cray-python/3.11.7

source ~/MA-NormEmergence/norm-env/bin/activate

echo "===== ENVIRONMENT ====="
which python
python --version
echo

echo "===== GPU INFO ====="
nvidia-smi
echo

export MODEL_DIR=$SCRATCHDIR/models

echo "===== RUNNING SCRIPT ====="
python code/run_condition.py \
	--model qwen3_8b \
	--prompt unframed \
	--rule-policy self_interested \
	--seed 42 \
	--max-steps 3
echo
echo "finished at $(date)"
